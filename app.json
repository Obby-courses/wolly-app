{
  "expo": {
    "name": "Wolly",
    "scheme": "wolly",
    "slug": "wolly",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./wolly_favicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./wolly_favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolly.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./wolly_favicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.wolly.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Wolly to access your microphone."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Wolly to access your camera."
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./wolly_favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e36d335-ab0b-4618-86d2-18462cc671de"
      }
    },
    "owner": "obbyapp",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2e36d335-ab0b-4618-86d2-18462cc671de"
    }
  }
}
