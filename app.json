{
  "expo": {
    "name": "Wolly",
    "scheme": "wolly",
    "slug": "wolly",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./wolly_favicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./wolly_favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolly.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./wolly_favicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.wolly.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Wolly to access your microphone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "Allow Wolly to access your camera."
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "favicon": "./wolly_favicon.png"
    }
  }
}
